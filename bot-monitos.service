[Unit]
Description=Bot Monitos Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/bot_monitos
EnvironmentFile=/home/orangepi/bot_monitos/.env
ExecStart=/home/orangepi/bot_monitos/venv/bin/python3 bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
